[mysqld]
# Basic Settings
user                            = mysql
default-storage-engine          = InnoDB
character-set-server            = utf8mb4
collation-server                = utf8mb4_0900_ai_ci

# Connection & Networking Settings
max_connections                 = 500
max_connect_errors              = 10000
connect_timeout                 = 20
wait_timeout                    = 600
interactive_timeout             = 600
max_allowed_packet              = 128M

# Fast Ingestion & Bulk Operations
local_infile                    = 1
secure_file_priv                = ""
bulk_insert_buffer_size         = 64M

# InnoDB Core Memory & I/O Architecture (Optimized for 1M - 10M rows)
innodb_buffer_pool_size         = 1G
innodb_buffer_pool_instances   = 2
innodb_log_file_size            = 256M
innodb_log_buffer_size          = 64M
innodb_flush_log_at_trx_commit  = 2
innodb_flush_method             = O_DIRECT
innodb_file_per_table           = 1
innodb_stats_on_metadata        = 0
innodb_read_io_threads          = 4
innodb_write_io_threads         = 4

# Query Optimization & Temp Tables
tmp_table_size                  = 128M
max_heap_table_size             = 128M
sort_buffer_size                = 8M
join_buffer_size                = 8M

# Logging & Observability for Tuning
slow_query_log                  = 1
slow_query_log_file             = /var/log/mysql/slow.log
long_query_time                 = 0.05
log_queries_not_using_indexes   = 1
min_examined_row_limit          = 1000

# Binary Logging & Replication Readiness
server-id                       = 101
log_bin                         = /var/log/mysql/mysql-bin.log
binlog_format                   = ROW
binlog_expire_logs_seconds      = 604800
gtid_mode                       = ON
enforce_gtid_consistency        = ON
